MISTRAL_API_KEY=your_mistral_api_key_here
# Admin portal (demo: username admin / password admin@123 via env, never in code)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123
# Default first-login password for admin-created users (user forced to change it)
DEFAULT_EMPLOYEE_PASSWORD=employee@123
# Optional overrides:
# ADMIN_PASSWORD_HASH=<hash from services.auth_db.hash_password>
# ADMIN_EMAIL=admin@nexora.com
# ADMIN_FULL_NAME=Platform Administrator
# ADMIN_DEPARTMENT=IT & SecOps
# Frontend flags:
# VITE_ENABLE_DEMO_LOGIN=false
# VITE_QUIZ_V2=false
# VITE_RESUME_PROFILE=false
